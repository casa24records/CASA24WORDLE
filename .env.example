# Copy to .env.local for local development (git- and Vercel-ignored), or run
#   vercel env pull .env.local --scope casa-24
# app.py reads .env.local only when not on Vercel and never overrides
# variables that are already set. Never commit real values.

# Developer view password (/demo). Empty = Developer view off.
DEMO_PASSWORD=

# Signs the leaderboard cookie (and the Developer view session). Long random value.
SECRET_KEY=

# Discord application (OAuth2, scope "identify"). Both needed for the leaderboard.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs that can hide names on /leaderboard.
ADMIN_DISCORD_IDS=

# Upstash Redis (added by the Vercel Marketplace integration). Either pair works.
# Without them: in-memory store locally, leaderboard off on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
