# Not needed on Vercel
.venv/
tests/
.claude/
drive_export/
**/__pycache__/
# Helper scripts (scripts/vercel_build.py runs during the build, so it is uploaded)
scripts/casa24/
scripts/merge_words.py
scripts/validate_words.py
scripts/brand_assets.py
scripts/screenshots.py
# member aliases never ship
webapp/data/languages/*/*_casa24_aliases.txt
# Gilroy is commercial and git-ignored; keep it out of CLI uploads too
# (Vercel uses this file instead of .gitignore when it exists)
webapp/static/fonts/Gilroy-*

# local Vercel link and env files (never upload)
.vercel
.env*
.agents/
skills-lock.json
# Tailwind build inputs: the compiled webapp/static/tailwind.css is committed and uploaded;
# the CLI cache (.cache/, git-ignored), its config, source CSS and build script are not needed on Vercel
.cache/
tailwind.config.js
scripts/build_css.py
webapp/static/src/
